{
 "id": "2026-10-26-tts-tok-mimi2",
 "what": "TTS: tokenize Emilia-EN train (46k h) with Mimi, 2 codebooks (0.28 kbps)",
 "script": "tts_tokenize.sbatch",
 "sbatch": {
  "array": "0-63",
  "time": "12:00:00"
 },
 "env": {
  "CODEC": "mimi",
  "OUT": "${FACT_DATA}/tts_tokens/mimi2",
  "NUM_PARTS": "64",
  "EXTRA": "--mimi-streams 2"
 },
 "collect": true
}
